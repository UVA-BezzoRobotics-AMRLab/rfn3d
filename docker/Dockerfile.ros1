# ROS1 (Noetic) image for rfn3d. rfn3d is a blended ROS1/ROS2 catkin/ament
# package that won't build natively on macOS; this builds the ROS1 `planner`
# target (and the ROS-free planner_lib core) in a Linux container and runs it.
# `docker compose build` fails loudly if it doesn't compile; `up`/`run` launches
# the node (see docker/entrypoint.ros1.sh). A ROS2 image lands separately.
#
# Uses the license-free gcopter back-end (no Gurobi). Pinned to linux/amd64 for
# parity with the ROS2 image; runs under emulation on Apple Silicon.
FROM --platform=linux/amd64 ros:noetic-ros-base

SHELL ["/bin/bash", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git \
      libeigen3-dev \
      ros-noetic-ompl \
      ros-noetic-octomap ros-noetic-octomap-msgs \
      ros-noetic-nav-msgs ros-noetic-geometry-msgs ros-noetic-std-msgs \
      ros-noetic-trajectory-msgs ros-noetic-visualization-msgs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /ws
COPY . src/rfn3d

RUN source /opt/ros/noetic/setup.bash \
    && catkin_make -DCMAKE_BUILD_TYPE=Release \
    && echo "=== rfn3d planner built OK ===" \
    && ls -la devel/lib/rfn3d/

COPY docker/entrypoint.ros1.sh /entrypoint.ros1.sh
RUN chmod +x /entrypoint.ros1.sh
ENTRYPOINT ["/entrypoint.ros1.sh"]
